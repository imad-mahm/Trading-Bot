# --- Paper bot secrets (Telegram alerts only) ---
#
# HOW TO USE:
#   1. Copy this file to ".env"  (just the name .env, no .example)
#   2. Fill in the two values below
#   3. Run the bot normally — it loads .env automatically
#
# The real ".env" is gitignored, so your token never gets committed.
# Both values are OPTIONAL: leave them blank to skip Telegram (alerts then
# just go to the log file) — the bot runs the same either way.

# From @BotFather on Telegram: /newbot -> it gives you this token.
TELEGRAM_BOT_TOKEN=

# Message your new bot once, then open:
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and copy the "chat":{"id": ... } number.
TELEGRAM_CHAT_ID=

# --- Exchange trading (trade.py) — Binance API keys ---
#
# Which keys depends on exchange_trading.environment in config.yaml:
#   testnet -> create keys at https://testnet.binance.vision (log in with GitHub)
#   demo    -> create keys in Binance Demo Trading (demo.binance.com, API Management)
#   live    -> create keys on binance.com with:
#                * "Enable Spot & Margin Trading" ON
#                * "Enable Withdrawals" OFF   (trade.py check refuses keys that can withdraw)
#                * "Restrict access to trusted IPs" = your VM's public IP
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Real money ONLY: the second key of the double-key switch. Leave blank on
# testnet/demo. For live, set to exactly:  yes-real-money
LIVE_TRADING_CONFIRM=
